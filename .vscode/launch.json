{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "ADK Web (Gemini)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/.venv/bin/adk",
            "args": [
                "web",
                "--port",
                "8000",
                "--reload",
                "--reload_agents",
                "pokedex_agent"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "python": "${command:python.interpreterPath}",
            "envFile": "${workspaceFolder}/.env.gemini",
            "justMyCode": false
        },
        {
            "name": "ADK Web (Ollama)",
            "type": "debugpy",

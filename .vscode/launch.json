                "8000",
                "--reload",
                "--reload_agents",
                "pokedex_agent"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "python": "${command:python.interpreterPath}",
            "envFile": "${workspaceFolder}/.env.nvidia",
            "justMyCode": false
        }
    ]
}

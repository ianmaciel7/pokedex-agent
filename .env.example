GOOGLE_GENAI_USE_ENTERPRISE=0

# Use "google" for Gemini API or "local" for Ollama/LiteLLM.
MODEL_PROVIDER=google

# Use a Gemini API key from Google AI Studio.
# The SDK accepts GEMINI_API_KEY or GOOGLE_API_KEY.
# If both are set, GOOGLE_API_KEY takes precedence.
GOOGLE_API_KEY=your-google-ai-studio-api-key
GOOGLE_MODEL=gemini-flash-latest

# Local model settings for MODEL_PROVIDER=local or the "ADK Web (Ollama)" launch profile.
LOCAL_MODEL=ollama_chat/qwen3:4b
